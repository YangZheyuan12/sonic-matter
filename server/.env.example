OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PROTOCOL=responses
REPLICATE_API_TOKEN=
MUSIC_REPLICATE_MODEL=meta/musicgen
ELEVENLABS_API_KEY=
# 监听端口；本地开发用 8787，当前公网部署由 Node 监听 8088，再由 Nginx 的 80 端口反向代理
PORT=8787

# --- 服务端行为 ---
# 允许访问的浏览器来源，逗号分隔；留空表示允许任何来源（仅适合本地开发）
CORS_ORIGIN=
# 请求体上限，超过会返回 413
JSON_BODY_LIMIT=2mb
# 导出音频等本地数据的落盘目录，相对 server/ 解析；默认 generated
DATA_DIR=generated
# 云端工程库（SQLite）目录，相对 server/ 解析；默认 projects。
# 注意：DATA_DIR 是【公开】静态托管的（导出的音频要能被 <audio> 直接取），所以数据库必须放在它外面。
PROJECTS_DIR=projects

# --- 固定双账号初始化 ---
# 账号数据库与一次性初始凭据文件目录；不要放进 web/dist 或 generated。
AUTH_DIR=auth
AUTH_CREDENTIAL_FILE=auth/initial-credentials.txt

# --- 生产部署（Node 8088 + Nginx，见 deploy/README.md）---
# 1 = 由本服务同时托管前端构建产物（web/dist），浏览器只需访问一个端口；本地开发保持 0，继续用 Vite 的 5173
SERVE_WEB=0
# 前端构建产物目录，相对 server/ 解析
WEB_DIST_DIR=../web/dist



# --- 超时与重试（毫秒）---
# Agent（OpenAI 兼容接口）单次请求超时
AGENT_TIMEOUT_MS=60000
# 音频生成 / 音频下载这类慢接口的单次超时
PROVIDER_TIMEOUT_MS=180000
# 整个 HTTP 请求的上限，兜住所有上游调用的组合耗时
REQUEST_TIMEOUT_MS=300000
# 上游请求最多尝试几次（1 表示不重试）；只重试网络错误 / 408 / 429 / 5xx
PROVIDER_RETRY_ATTEMPTS=3
# 退避基数：第 n 次重试等 base * 2^(n-1) 毫秒（最多 8 秒），并优先遵守上游 Retry-After
PROVIDER_RETRY_BASE_MS=500

# --- 日志 ---
# debug | info | warn | error（默认 info）
LOG_LEVEL=info
